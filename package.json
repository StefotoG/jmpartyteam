{
  "name": "dj-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "placeholders": "node scripts/generate-placeholders.mjs",
    "seed": "node --env-file-if-exists=.env scripts/seed-sanity.mjs",
    "db:migrate": "node --env-file-if-exists=.env src/server/db/migrate.ts",
    "experiment": "node scripts/experiment-concurrency.ts",
    "experiment:holds": "node scripts/experiment-holds.ts",
    "experiment:charts": "node scripts/experiment-charts.ts",
    "sus": "node scripts/sus-score.ts",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs",
    "test:e2e": "astro dev --background && playwright test",
    "thesis:pdf": "node scripts/thesis-pdf.mjs",
    "deploy": "netlify deploy --build --prod",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.3",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.0",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.1",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "markdown-it": "^15.0.0",
    "mermaid": "^11.17.0",
    "puppeteer-core": "^25.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
