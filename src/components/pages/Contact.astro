---
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import BookingForm from '../BookingForm.astro';
import { getSiteContent } from '../../lib/content';
import type { Locale } from '../../i18n/routes';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { settings } = await getSiteContent();

const copy = {
  bg: {
    title: 'Контакти и запитване | JM Party Team',
    description:
      'Свържете се с нас за диджей и озвучаване. Отговаряме на всяко запитване до 24 часа.',
    heading: 'Запитване за дата',
    lead: 'Попълнете формата или ни се обадете. Отговаряме до 24 часа, включително в почивните дни.',
    directTitle: 'Директен контакт',
    citiesTitle: 'Работим в',
    responseTitle: 'Какво следва',
    responseSteps: [
      'Получавате отговор до 24 часа с потвърждение дали датата е свободна.',
      'Уточняваме детайлите по телефон или на среща.',
      'Подписваме договор и датата се запазва с депозит.',
    ],
  },
  en: {
    title: 'Contact and booking enquiry | JM Party Team',
    description:
      'Get in touch about DJ and sound services. We answer every enquiry within 24 hours.',
    heading: 'Check your date',
    lead: 'Fill in the form or call us. We reply within 24 hours, weekends included.',
    directTitle: 'Direct contact',
    citiesTitle: 'We work in',
    responseTitle: 'What happens next',
    responseSteps: [
      'You get a reply within 24 hours confirming whether the date is free.',
      'We agree the details by phone or at a meeting.',
      'We sign a contract and the date is held with a deposit.',
    ],
  },
}[lang];

const telHref = `tel:${settings.phonePrimary.replace(/\s/g, '')}`;
const viberHref = settings.viber
  ? `viber://chat?number=${encodeURIComponent(settings.viber)}`
  : null;
const whatsappHref = settings.whatsapp
  ? `https://wa.me/${settings.whatsapp.replace(/\D/g, '')}`
  : null;
---

<Base
  lang={lang}
  routeKey="contact"
  title={copy.title}
  description={copy.description}
>
  <Section title={copy.heading} lead={copy.lead}>
    <div class="grid gap-12 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <BookingForm lang={lang} />
      </div>

      <aside class="grid gap-8 lg:col-span-2">
        <div class="rounded-2xl border border-line bg-surface p-6">
          <h2 class="text-lg font-bold">{copy.directTitle}</h2>
          <ul class="mt-4 grid gap-3 text-sm">
            <li>
              <a href={telHref} class="font-semibold hover:text-accent">
                {settings.phonePrimary}
              </a>
            </li>
            {
              settings.phoneSecondary && (
                <li>
                  <a
                    href={`tel:${settings.phoneSecondary.replace(/\s/g, '')}`}
                    class="font-semibold hover:text-accent"
                  >
                    {settings.phoneSecondary}
                  </a>
                </li>
              )
            }
            <li>
              <a
                href={`mailto:${settings.email}`}
                class="text-muted hover:text-text"
              >
                {settings.email}
              </a>
            </li>
          </ul>

          <div class="mt-5 flex flex-wrap gap-3">
            {
              viberHref && (
                <a
                  href={viberHref}
                  class="rounded-xl border border-line px-4 py-2.5 text-sm font-semibold hover:border-accent"
                >
                  Viber
                </a>
              )
            }
            {
              whatsappHref && (
                <a
                  href={whatsappHref}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="rounded-xl border border-line px-4 py-2.5 text-sm font-semibold hover:border-accent"
                >
                  WhatsApp
                </a>
              )
            }
          </div>
        </div>

        <div class="rounded-2xl border border-line bg-surface p-6">
          <h2 class="text-lg font-bold">{copy.responseTitle}</h2>
          <ol class="mt-4 grid gap-3 text-sm text-muted">
            {
              copy.responseSteps.map((step, index) => (
                <li class="flex gap-3">
                  <span class="font-display font-bold text-accent">
                    {index + 1}
                  </span>
                  {step}
                </li>
              ))
            }
          </ol>
        </div>

        <div class="rounded-2xl border border-line bg-surface p-6">
          <h2 class="text-lg font-bold">{copy.citiesTitle}</h2>
          <p class="mt-3 text-sm text-muted">
            {settings.cities[lang].join(' · ')}
          </p>
        </div>
      </aside>
    </div>
  </Section>
</Base>
