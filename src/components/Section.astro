---
interface Props {
  id?: string;
  title?: string;
  lead?: string;
  align?: 'left' | 'center';
  tone?: 'ink' | 'surface';
  class?: string;
}

const {
  id,
  title,
  lead,
  align = 'left',
  tone = 'ink',
  class: className = '',
} = Astro.props;
---

<section
  id={id}
  class:list={[
    'py-16 md:py-24',
    tone === 'surface' ? 'bg-surface' : 'bg-ink',
    className,
  ]}
>
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    {
      (title || lead) && (
        <div
          class:list={[
            'mb-10 md:mb-14',
            align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl',
          ]}
        >
          {title && (
            <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">
              {title}
            </h2>
          )}
          {lead && <p class="mt-4 text-lg text-muted">{lead}</p>}
        </div>
      )
    }
    <slot />
  </div>
</section>
