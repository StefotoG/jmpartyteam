---
import { useTranslations } from '../i18n/ui';
import { getSiteContent } from '../lib/content';
import { localePath, type Locale } from '../i18n/routes';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { settings } = await getSiteContent();

const telHref = `tel:${settings.phonePrimary.replace(/\s/g, '')}`;
const viberHref = settings.viber
  ? `viber://chat?number=${encodeURIComponent(settings.viber)}`
  : null;
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-ink/95 backdrop-blur-md md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <div class="grid grid-cols-3 gap-px">
    <a
      href={telHref}
      class="flex flex-col items-center gap-1 py-3 text-xs font-semibold text-text"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
        ></path>
      </svg>
      {t('cta.call')}
    </a>

    {
      viberHref && (
        <a
          href={viberHref}
          class="flex flex-col items-center gap-1 py-3 text-xs font-semibold text-text"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          </svg>
          {t('cta.viber')}
        </a>
      )
    }

    <a
      href={localePath(lang, 'contact')}
      class="flex flex-col items-center gap-1 bg-accent py-3 text-xs font-bold text-accent-ink"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
        <path d="M16 2v4M8 2v4M3 10h18"></path>
      </svg>
      {t('cta.book')}
    </a>
  </div>
</div>
