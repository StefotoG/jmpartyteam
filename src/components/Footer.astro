---
import { useTranslations } from '../i18n/ui';
import { getSiteContent } from '../lib/content';
import { localePath, type Locale, type RouteKey } from '../i18n/routes';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { settings } = await getSiteContent();

const primaryLinks = [
  ['services', t('nav.services')],
  ['gallery', t('nav.gallery')],
  ['music', t('nav.music')],
  ['pricing', t('nav.pricing')],
] as const satisfies readonly (readonly [RouteKey, string])[];

const secondaryLinks = [
  ['testimonials', t('nav.testimonials')],
  ['faq', t('nav.faq')],
  ['about', t('nav.about')],
  ['contact', t('nav.contact')],
] as const satisfies readonly (readonly [RouteKey, string])[];

const socials = [
  ['Instagram', settings.instagram],
  ['Facebook', settings.facebook],
  ['TikTok', settings.tiktok],
].filter((entry): entry is [string, string] => Boolean(entry[1]));

const year = new Date().getFullYear();
const telHref = `tel:${settings.phonePrimary.replace(/\s/g, '')}`;
---

<footer class="border-t border-line/60 bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-1">
        <p class="font-display text-lg font-extrabold">
          <span class="text-text">JM</span>
          <span class="text-accent">PARTY</span>
          <span class="text-text">TEAM</span>
        </p>
        <p class="mt-3 text-sm text-muted">{t('site.tagline')}</p>

        {
          socials.length > 0 && (
            <ul class="mt-5 flex gap-3">
              {socials.map(([name, url]) => (
                <li>
                  <a
                    href={url}
                    rel="me noopener noreferrer"
                    target="_blank"
                    class="text-sm text-muted underline underline-offset-4 hover:text-text"
                  >
                    {name}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <nav class="text-sm" aria-label={t('nav.services')}>
        <ul class="grid gap-2.5">
          {
            primaryLinks.map(([key, label]) => (
              <li>
                <a
                  href={localePath(lang, key)}
                  class="text-muted transition-colors hover:text-text"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="text-sm" aria-label={t('nav.about')}>
        <ul class="grid gap-2.5">
          {
            secondaryLinks.map(([key, label]) => (
              <li>
                <a
                  href={localePath(lang, key)}
                  class="text-muted transition-colors hover:text-text"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="text-sm">
        <ul class="grid gap-2.5">
          <li>
            <a
              href={telHref}
              class="font-semibold text-text hover:text-accent"
            >
              {settings.phonePrimary}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${settings.email}`}
              class="text-muted transition-colors hover:text-text"
            >
              {settings.email}
            </a>
          </li>
          <li class="pt-2 text-muted">
            {settings.cities[lang].join(' · ')}
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-4 border-t border-line/60 pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {settings.brandName}. {t('footer.rights')}</p>
      <ul class="flex gap-5">
        <li>
          <a
            href={localePath(lang, 'privacy')}
            class="underline underline-offset-4 hover:text-text"
          >
            {t('footer.privacy')}
          </a>
        </li>
        <li>
          <a
            href={localePath(lang, 'terms')}
            class="underline underline-offset-4 hover:text-text"
          >
            {t('footer.terms')}
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
