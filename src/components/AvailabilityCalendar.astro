---
import { useTranslations } from '../i18n/ui';
import { localePath, type Locale } from '../i18n/routes';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const labels = {
  free: t('availability.free'),
  busy: t('availability.busy'),
  past: t('availability.past'),
  previous: t('a11y.previous'),
  next: t('a11y.next'),
};
---

<div
  id="availability-calendar"
  data-locale={lang === 'bg' ? 'bg-BG' : 'en-GB'}
  data-labels={JSON.stringify(labels)}
  class="rounded-2xl border border-line bg-surface p-5 md:p-7"
>
  <p id="availability-status" class="text-muted">
    {t('availability.loading')}
  </p>

  <div id="availability-body" hidden>
    <div class="flex items-center justify-between gap-4">
      <button
        type="button"
        id="cal-prev"
        aria-label={labels.previous}
        class="rounded-lg border border-line px-3 py-2 text-text disabled:opacity-40"
      >
        ‹
      </button>
      <h3 id="cal-month" class="text-lg font-bold" aria-live="polite"></h3>
      <button
        type="button"
        id="cal-next"
        aria-label={labels.next}
        class="rounded-lg border border-line px-3 py-2 text-text disabled:opacity-40"
      >
        ›
      </button>
    </div>

    <table class="mt-5 w-full border-separate border-spacing-1 text-center">
      <thead>
        <tr id="cal-weekdays" class="text-xs text-muted"></tr>
      </thead>
      <tbody id="cal-grid"></tbody>
    </table>

    <ul class="mt-5 flex flex-wrap gap-4 text-sm text-muted">
      <li class="flex items-center gap-2">
        <span
          class="inline-block h-3 w-3 rounded-sm border border-line bg-ink"
          aria-hidden="true"></span>
        {labels.free}
      </li>
      <li class="flex items-center gap-2">
        <span
          class="inline-block h-3 w-3 rounded-sm bg-accent"
          aria-hidden="true"></span>
        {labels.busy}
      </li>
    </ul>

    <p class="mt-5 border-t border-line pt-4 text-sm text-muted">
      {t('availability.disclaimer')}
    </p>
  </div>

  <div id="availability-error" hidden>
    <p class="text-muted">{t('availability.unavailable')}</p>
    <a
      href={localePath(lang, 'contact')}
      class="mt-4 inline-block rounded-xl bg-accent px-5 py-3 font-bold text-accent-ink"
    >
      {t('cta.book')}
    </a>
  </div>
</div>

<script>
  interface Labels {
    free: string;
    busy: string;
    past: string;
    previous: string;
    next: string;
  }

  const root = document.getElementById('availability-calendar');
  if (root) {
    const locale = root.dataset.locale ?? 'bg-BG';
    const labels: Labels = JSON.parse(root.dataset.labels ?? '{}');

    const statusEl = document.getElementById('availability-status')!;
    const bodyEl = document.getElementById('availability-body')!;
    const errorEl = document.getElementById('availability-error')!;
    const monthEl = document.getElementById('cal-month')!;
    const gridEl = document.getElementById('cal-grid')!;
    const weekdaysEl = document.getElementById('cal-weekdays')!;
    const prevBtn = document.getElementById('cal-prev') as HTMLButtonElement;
    const nextBtn = document.getElementById('cal-next') as HTMLButtonElement;

    const monthFormatter = new Intl.DateTimeFormat(locale, {
      month: 'long',
      year: 'numeric',
    });
    const weekdayFormatter = new Intl.DateTimeFormat(locale, {
      weekday: 'short',
    });
    const fullDateFormatter = new Intl.DateTimeFormat(locale, {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });

    const busy = new Set<string>();
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const firstMonth = new Date(today.getFullYear(), today.getMonth(), 1);
    const lastMonth = new Date(today.getFullYear(), today.getMonth() + 18, 1);
    let cursor = new Date(firstMonth);

    const isoDate = (date: Date) =>
      `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(
        date.getDate()
      ).padStart(2, '0')}`;

    // Monday-first, matching Bulgarian convention.
    function renderWeekdays() {
      const reference = new Date(2024, 0, 1);
      for (let index = 0; index < 7; index += 1) {
        const day = new Date(reference);
        day.setDate(reference.getDate() + index);
        const cell = document.createElement('th');
        cell.scope = 'col';
        cell.textContent = weekdayFormatter.format(day);
        weekdaysEl.appendChild(cell);
      }
    }

    function renderMonth() {
      monthEl.textContent = monthFormatter.format(cursor);
      gridEl.textContent = '';

      const year = cursor.getFullYear();
      const month = cursor.getMonth();
      const firstDay = new Date(year, month, 1);
      const offset = (firstDay.getDay() + 6) % 7;
      const daysInMonth = new Date(year, month + 1, 0).getDate();

      let row = document.createElement('tr');
      for (let index = 0; index < offset; index += 1) {
        row.appendChild(document.createElement('td'));
      }

      for (let day = 1; day <= daysInMonth; day += 1) {
        if (row.children.length === 7) {
          gridEl.appendChild(row);
          row = document.createElement('tr');
        }

        const date = new Date(year, month, day);
        const key = isoDate(date);
        const isPast = date < today;
        const isBusy = busy.has(key);

        const cell = document.createElement('td');
        cell.textContent = String(day);
        cell.className = [
          'rounded-md py-2 text-sm',
          isPast
            ? 'text-muted/40'
            : isBusy
              ? 'bg-accent font-bold text-accent-ink'
              : 'border border-line text-text',
        ].join(' ');

        const state = isPast ? labels.past : isBusy ? labels.busy : labels.free;
        cell.setAttribute(
          'aria-label',
          `${fullDateFormatter.format(date)} — ${state}`
        );

        row.appendChild(cell);
      }

      gridEl.appendChild(row);

      prevBtn.disabled = cursor <= firstMonth;
      nextBtn.disabled = cursor >= lastMonth;
    }

    prevBtn.addEventListener('click', () => {
      cursor = new Date(cursor.getFullYear(), cursor.getMonth() - 1, 1);
      renderMonth();
    });

    nextBtn.addEventListener('click', () => {
      cursor = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1);
      renderMonth();
    });

    async function load() {
      try {
        const response = await fetch('/api/availability');
        if (!response.ok) throw new Error(String(response.status));

        const data = (await response.json()) as {
          error?: boolean;
          busyDates?: string[];
        };
        if (data.error) throw new Error('upstream');

        for (const date of data.busyDates ?? []) busy.add(date);

        statusEl.hidden = true;
        bodyEl.hidden = false;
        renderWeekdays();
        renderMonth();
      } catch {
        // Never render an empty calendar: it would imply every date is free.
        statusEl.hidden = true;
        errorEl.hidden = false;
      }
    }

    load();
  }
</script>
