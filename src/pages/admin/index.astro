---
export const prerender = false;

import '../../styles/admin.css';
import { db } from '../../server/db/client';
import { isValidSession, SESSION_COOKIE } from '../../server/auth/session';
import { listBookings } from '../../server/domain/bookings';

if (!isValidSession(Astro.cookies.get(SESSION_COOKIE)?.value)) {
  return Astro.redirect('/admin/login', 303);
}

const bookings = await listBookings(db());

const STATUS_LABELS: Record<string, string> = {
  enquiry: 'Запитване',
  quoted: 'Оферирано',
  confirmed: 'Потвърдено',
  completed: 'Приключено',
  cancelled: 'Отказано',
  declined: 'Отклонено',
};
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Запитвания · JM Party Team</title>
  </head>
  <body>
    <main>
      <div class="masthead">
        <h1>Запитвания</h1>
        <p class="count">{bookings.length} записа</p>
      </div>

      {
        bookings.length === 0 ? (
          <p class="empty">Все още няма запитвания.</p>
        ) : (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Дата</th>
                  <th>Номер</th>
                  <th>Клиент</th>
                  <th>Телефон</th>
                  <th>Услуга</th>
                  <th>Град</th>
                  <th>Гости</th>
                  <th>Статус</th>
                </tr>
              </thead>
              <tbody>
                {bookings.map((booking) => (
                  <tr>
                    <td class="date">{booking.eventDate}</td>
                    <td class="reference">{booking.reference}</td>
                    <td>{booking.customerName}</td>
                    <td>
                      <a href={`tel:${booking.phone}`}>{booking.phone}</a>
                    </td>
                    <td>{booking.serviceKey}</td>
                    <td>{booking.city}</td>
                    <td>{booking.guestCount ?? '—'}</td>
                    <td>{STATUS_LABELS[booking.status] ?? booking.status}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </main>
  </body>
</html>
