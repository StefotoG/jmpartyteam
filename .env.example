# Sanity — leave unset to build from local placeholder content in src/content/placeholder.ts
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Write token, only needed locally to run `npm run seed`. Never set this on Netlify.
SANITY_WRITE_TOKEN=

# Set to "true" only on the production Netlify context. The build then fails if any
# content is still flagged isPlaceholder, so seeded copy cannot reach real customers.
REQUIRE_REAL_CONTENT=
