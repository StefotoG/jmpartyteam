# Sanity — leave unset to build from local placeholder content in src/content/placeholder.ts
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Google Calendar availability (Netlify function only — never exposed to the browser).
# Create a service account, share the DJs' calendar with its email as read-only,
# then paste the values below. Keep GOOGLE_PRIVATE_KEY quoted with literal \n.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Set to "true" only on the production Netlify context. The build then fails if any
# content is still flagged isPlaceholder, so seeded copy cannot reach real customers.
REQUIRE_REAL_CONTENT=
